```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python related (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.temp

# Coverage reports
coverage/
htmlcov/
.coverage

# Distribution / packaging
*.tar.gz
*.zip
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db
```